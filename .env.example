# Copy to .env and fill in. .env is gitignored -- never commit real keys.

OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...

# Pinecone index name and region
PINECONE_INDEX=bullbot
PINECONE_ENVIRONMENT=us-east-1

# Serverless index host (Pinecone console -> your index -> Host).
# Optional -- the client can resolve it -- but setting it avoids a lookup on boot.
PINECONE_HOST=https://<index>-<hash>.svc.<region>.pinecone.io

# Port the Flask API binds to (default 8000)
PORT=8000
